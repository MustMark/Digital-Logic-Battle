# Auto detect text
* text=auto

# Force LF for HDL
*.vhd text eol=lf
*.v text eol=lf
*.ucf text eol=lf
*.xdc text eol=lf

# Binary files
*.bit binary
*.ngc binary
*.ncd binary
*.png binary
*.jpg binary
*.pdf binary

# GitHub Language
* linguist-detectable=false
*.vhd linguist-detectable=true
*.v linguist-detectable=true
*.sv linguist-detectable=true